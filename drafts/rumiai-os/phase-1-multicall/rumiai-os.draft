#!/bin/sh

# DRAFT ONLY — non-normative code proposal.
# This file is intentionally close to executable POSIX shell so the multicall
# bootstrap/dispatch model can be reviewed before product implementation.

# Preserve invocation identity BEFORE phase 0 resolves the final symlink.
RumiAI_INVOKED_AS=${0##*/}
RumiAI_INVOKED_BIN=

# -----------------------------------------------------------------------------
# Phase 0 — physical bootstrap discovery, with invocation identity preserved.

RumiAI_BOOTSTRAP_FATAL_PATH_RESOLUTION_ERROR=1
RumiAI_BOOTSTRAP_FATAL_REALPATH_ERROR=2
RumiAI_BOOTSTRAP_FATAL_BIN_ERROR=3
RumiAI_BOOTSTRAP_FATAL_ROOT_ERROR=4

case $0 in
  */*)
    RumiAI_INVOKED_BIN=$0
    ;;
  *)
    if ! RumiAI_INVOKED_BIN=$(command -v -- "$0" 2>/dev/null)
    then
      printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_PATH_RESOLUTION_ERROR' >&2
      exit "$RumiAI_BOOTSTRAP_FATAL_PATH_RESOLUTION_ERROR"
    fi
    ;;
esac

RumiAI_BOOTSTRAP_BIN=$RumiAI_INVOKED_BIN

if ! RumiAI_BOOTSTRAP_BIN=$(command -p -- realpath -e -- "$RumiAI_BOOTSTRAP_BIN" 2>/dev/null)
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_REALPATH_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_REALPATH_ERROR"
fi

if [ ! -f "$RumiAI_BOOTSTRAP_BIN" ]
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_BIN_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_BIN_ERROR"
fi

RumiAI_ROOT=${RumiAI_BOOTSTRAP_BIN%/*}
[ -n "$RumiAI_ROOT" ] || RumiAI_ROOT=/

if ! (cd -- "$RumiAI_ROOT" 2>/dev/null)
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_ROOT_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_ROOT_ERROR"
fi

export -- RumiAI_BOOTSTRAP_BIN RumiAI_ROOT
readonly -- RumiAI_BOOTSTRAP_BIN RumiAI_ROOT

unset -v -- \
  RumiAI_BOOTSTRAP_FATAL_PATH_RESOLUTION_ERROR \
  RumiAI_BOOTSTRAP_FATAL_REALPATH_ERROR \
  RumiAI_BOOTSTRAP_FATAL_BIN_ERROR \
  RumiAI_BOOTSTRAP_FATAL_ROOT_ERROR

# -----------------------------------------------------------------------------
# Phase 1A — semantic roots.

RumiAI_BIN_DIR=$RumiAI_ROOT/bin
RumiAI_COMMAND_DIR=$RumiAI_ROOT/cmd
RumiAI_LIB_DIR=$RumiAI_ROOT/lib
RumiAI_CONF_DIR=$RumiAI_ROOT/conf
RumiAI_LANG_DIR=$RumiAI_ROOT/lang

PATH=$RumiAI_BIN_DIR${PATH:+:$PATH}

export -- \
  RumiAI_BIN_DIR \
  RumiAI_COMMAND_DIR \
  RumiAI_LIB_DIR \
  RumiAI_CONF_DIR \
  RumiAI_LANG_DIR \
  PATH

# -----------------------------------------------------------------------------
# Phase 1B — minimal bootstrap preference reader.
#
# Bootstrap preference files are data, never sourced shell code. The current
# draft contract is one non-empty newline-terminated physical line per file.

RumiAI_bootstrap_read_value()
(
  [ "$#" -eq 1 ] || return 3

  RumiAI_bootstrap_file=$1
  [ -f "$RumiAI_bootstrap_file" ] || return 1
  [ -r "$RumiAI_bootstrap_file" ] || return 2

  if ! exec 3< "$RumiAI_bootstrap_file"
  then
    return 2
  fi

  RumiAI_bootstrap_value=
  if ! IFS= read -r RumiAI_bootstrap_value <&3
  then
    exec 3<&-
    return 3
  fi

  if [ -z "$RumiAI_bootstrap_value" ]
  then
    exec 3<&-
    return 3
  fi

  RumiAI_bootstrap_extra=
  if IFS= read -r RumiAI_bootstrap_extra <&3 || [ -n "$RumiAI_bootstrap_extra" ]
  then
    exec 3<&-
    return 3
  fi

  exec 3<&-
  printf -- '%s\n' "$RumiAI_bootstrap_value"
)

RumiAI_BOOTSTRAP_LANGUAGE_FILE=$RumiAI_CONF_DIR/bootstrap/language
RumiAI_BOOTSTRAP_TEXT_ENCODING_FILE=$RumiAI_CONF_DIR/bootstrap/text-encoding

RumiAI_BOOTSTRAP_LANGUAGE_CONFIG_INVALID=
RumiAI_BOOTSTRAP_TEXT_ENCODING_CONFIG_INVALID=

RumiAI_LANGUAGE_REQUESTED=

if [ -f "$RumiAI_BOOTSTRAP_LANGUAGE_FILE" ]
then
  if ! RumiAI_LANGUAGE_REQUESTED=$(RumiAI_bootstrap_read_value "$RumiAI_BOOTSTRAP_LANGUAGE_FILE")
  then
    RumiAI_BOOTSTRAP_LANGUAGE_CONFIG_INVALID=1
    RumiAI_LANGUAGE_REQUESTED=
  fi
fi

if [ -z "$RumiAI_LANGUAGE_REQUESTED" ]
then
  if [ -n "${LC_ALL-}" ]
  then
    RumiAI_LANGUAGE_REQUESTED=$LC_ALL
  elif [ -n "${LC_MESSAGES-}" ]
  then
    RumiAI_LANGUAGE_REQUESTED=$LC_MESSAGES
  elif [ -n "${LANG-}" ]
  then
    RumiAI_LANGUAGE_REQUESTED=$LANG
  else
    RumiAI_LANGUAGE_REQUESTED=en_US
  fi
fi

RumiAI_TEXT_ENCODING_REQUESTED=UTF-8

if [ -f "$RumiAI_BOOTSTRAP_TEXT_ENCODING_FILE" ]
then
  if ! RumiAI_TEXT_ENCODING_REQUESTED=$(RumiAI_bootstrap_read_value "$RumiAI_BOOTSTRAP_TEXT_ENCODING_FILE")
  then
    RumiAI_BOOTSTRAP_TEXT_ENCODING_CONFIG_INVALID=1
    RumiAI_TEXT_ENCODING_REQUESTED=UTF-8
  fi
fi

# -----------------------------------------------------------------------------
# Phase 1C — i18n initialization.

RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR=5
RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR=6

if [ ! -f "$RumiAI_LIB_DIR/i18n.lib" ] || [ ! -r "$RumiAI_LIB_DIR/i18n.lib" ]
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR"
fi

. "$RumiAI_LIB_DIR/i18n.lib"
RumiAI_load_status=$?
if [ "$RumiAI_load_status" -ne 0 ]
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR"
fi

RumiAI_LANGUAGE_FALLBACK=
if RumiAI_LANGUAGE=$(RumiAI_i18n_select_language "$RumiAI_LANGUAGE_REQUESTED")
then
  :
else
  RumiAI_LANGUAGE_FALLBACK=1
fi

RumiAI_TEXT_ENCODING_FALLBACK=
if RumiAI_TEXT_ENCODING=$(RumiAI_i18n_select_text_encoding "$RumiAI_TEXT_ENCODING_REQUESTED")
then
  :
else
  RumiAI_TEXT_ENCODING_FALLBACK=1
fi

export -- RumiAI_LANGUAGE RumiAI_TEXT_ENCODING

# -----------------------------------------------------------------------------
# Phase 1D — logger initialization.

if [ ! -f "$RumiAI_LIB_DIR/log.lib" ] || [ ! -r "$RumiAI_LIB_DIR/log.lib" ]
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR"
fi

. "$RumiAI_LIB_DIR/log.lib"
RumiAI_load_status=$?
if [ "$RumiAI_load_status" -ne 0 ]
then
  printf -- '%s\n' 'RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR' >&2
  exit "$RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR"
fi

unset -v -- \
  RumiAI_BOOTSTRAP_FATAL_I18N_LOAD_ERROR \
  RumiAI_BOOTSTRAP_FATAL_LOG_LOAD_ERROR \
  RumiAI_load_status

# LOGGER ACTIVE from here onward.

if [ -n "$RumiAI_BOOTSTRAP_LANGUAGE_CONFIG_INVALID" ]
then
  log warn bootstrap language-config-invalid \
    path "$RumiAI_BOOTSTRAP_LANGUAGE_FILE"
fi

if [ -n "$RumiAI_BOOTSTRAP_TEXT_ENCODING_CONFIG_INVALID" ]
then
  log warn bootstrap text-encoding-config-invalid \
    path "$RumiAI_BOOTSTRAP_TEXT_ENCODING_FILE"
fi

if [ -n "$RumiAI_LANGUAGE_FALLBACK" ]
then
  log warn bootstrap language-fallback \
    requested "$RumiAI_LANGUAGE_REQUESTED" \
    selected "$RumiAI_LANGUAGE"
fi

if [ -n "$RumiAI_TEXT_ENCODING_FALLBACK" ]
then
  log warn bootstrap text-encoding-fallback \
    requested "$RumiAI_TEXT_ENCODING_REQUESTED" \
    selected "$RumiAI_TEXT_ENCODING"
fi

unset -v -- \
  RumiAI_BOOTSTRAP_LANGUAGE_CONFIG_INVALID \
  RumiAI_BOOTSTRAP_TEXT_ENCODING_CONFIG_INVALID \
  RumiAI_LANGUAGE_FALLBACK \
  RumiAI_TEXT_ENCODING_FALLBACK

# -----------------------------------------------------------------------------
# Public command name validation.

RumiAI_command_name_valid()
{
  case $1 in
    [a-z0-9]*)
      case $1 in
        *[!a-z0-9-]* | *-)
          return 1
          ;;
      esac
      ;;
    *)
      return 1
      ;;
  esac

  return 0
}

# -----------------------------------------------------------------------------
# Front-controller/dispatch errors.
#
# Shared bootstrap/front-controller numbering is sequential in this proposal.
# Command-specific/library error namespaces still require a final mapping policy
# before the CLI contracts are frozen.

RumiAI_DISPATCH_ERROR_INVALID_MULTICALL=7
RumiAI_DISPATCH_ERROR_INVALID_COMMAND=8
RumiAI_DISPATCH_ERROR_COMMAND_UNAVAILABLE=9

RumiAI_BOOTSTRAP_NAME=${RumiAI_BOOTSTRAP_BIN##*/}
RumiAI_COMMAND=

# Normal form:
#   rumiai-os log warn ...
#
# Multicall forms:
#   $RumiAI_BIN_DIR/log -> ../rumiai-os
#   /external/path/log  -> /path/to/RumiAI/rumiai-os
#
# An external alias is accepted only when its basename identifies an official
# RumiAI public command whose canonical bin entry resolves to this same physical
# rumiai-os. The location of the external alias itself is therefore irrelevant.

if [ "$RumiAI_INVOKED_AS" = "$RumiAI_BOOTSTRAP_NAME" ]
then
  if [ "$#" -gt 0 ]
  then
    RumiAI_COMMAND=$1
    shift
  fi
else
  if ! RumiAI_command_name_valid "$RumiAI_INVOKED_AS"
  then
    log error bootstrap invalid-multicall invoked-as "$RumiAI_INVOKED_AS"
    exit "$RumiAI_DISPATCH_ERROR_INVALID_MULTICALL"
  fi

  RumiAI_PUBLIC_COMMAND=$RumiAI_BIN_DIR/$RumiAI_INVOKED_AS

  if ! RumiAI_PUBLIC_COMMAND_TARGET=$(command -p -- realpath -e -- "$RumiAI_PUBLIC_COMMAND" 2>/dev/null)
  then
    log error bootstrap invalid-multicall invoked-as "$RumiAI_INVOKED_AS"
    exit "$RumiAI_DISPATCH_ERROR_INVALID_MULTICALL"
  fi

  if [ "$RumiAI_PUBLIC_COMMAND_TARGET" != "$RumiAI_BOOTSTRAP_BIN" ]
  then
    log error bootstrap invalid-multicall invoked-as "$RumiAI_INVOKED_AS"
    exit "$RumiAI_DISPATCH_ERROR_INVALID_MULTICALL"
  fi

  RumiAI_COMMAND=$RumiAI_INVOKED_AS
fi

# Empty command means the front controller itself was invoked with no command.
# Its eventual default behavior is outside this draft.
if [ -z "$RumiAI_COMMAND" ]
then
  exit 0
fi

if ! RumiAI_command_name_valid "$RumiAI_COMMAND"
then
  log error bootstrap invalid-command command "$RumiAI_COMMAND"
  exit "$RumiAI_DISPATCH_ERROR_INVALID_COMMAND"
fi

export -- RumiAI_COMMAND

# -----------------------------------------------------------------------------
# Hybrid dispatch.

case $RumiAI_COMMAND in
  log)
    # log.lib is already sourced in this shell, so no second executable or
    # second bootstrap is needed.
    log "$@"
    exit $?
    ;;

  *)
    RumiAI_COMMAND_BIN=$RumiAI_COMMAND_DIR/$RumiAI_COMMAND

    if [ ! -f "$RumiAI_COMMAND_BIN" ] || [ ! -x "$RumiAI_COMMAND_BIN" ]
    then
      log error bootstrap command-unavailable command "$RumiAI_COMMAND"
      exit "$RumiAI_DISPATCH_ERROR_COMMAND_UNAVAILABLE"
    fi

    # Deliberately not using exec in this draft. Keeping the front-controller
    # process makes failure/status propagation explicit while we review the
    # contract. A later implementation can evaluate exec as an optimization.
    "$RumiAI_COMMAND_BIN" "$@"
    exit $?
    ;;
esac
